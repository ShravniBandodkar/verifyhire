{
  "name": "verifyhire-desktop",
  "productName": "VerifyHire",
  "version": "1.0.0",
  "description": "VerifyHire desktop client (Windows & macOS)",
  "main": "main.js",
  "author": "VerifyHire",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "VH_SERVER_URL=http://localhost:8000 electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.verifyhire.desktop",
    "productName": "VerifyHire",
    "files": ["main.js", "preload.js", "build/icon.png", "package.json"],
    "mac": { "category": "public.app-category.business", "target": ["dmg"], "icon": "build/icon.png" },
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
